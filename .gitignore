# ==============================================================================
# Marconi AWS Observer Dashboard - .gitignore
# ==============================================================================

# --- Environment & Secrets ---
.env
.env.local
.env.*.local
*.env
!.env.example
!backend/.env.example
!frontend/.env.example

# --- Python Backend ---
__pycache__/
*.py[cod]
*$py.class
*.so

# Python Virtual Environments
.venv/
venv/
ENV/
env/
env.bak/
venv.bak/

# Testing & Coverage
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/

# Python Distribution / Packaging
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Database temporary & journal files
*.sqlite3-journal
*.sqlite3-wal
*.sqlite3-shm
*.db-journal

# --- Node / Frontend (React + Vite) ---
node_modules/
frontend/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Frontend Build Outputs
frontend/dist/
frontend/dist-ssr/
dist/
dist-ssr/

# Vite Cache
.vite/
frontend/.vite/

# --- IDE & Editor Artifacts ---
.idea/
.vscode/
*.swp
*.swo
*~
*.sublime-project
*.sublime-workspace

# --- Operating System Files ---
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# --- Logs & Temp ---
*.log
logs/
temp/
tmp/
